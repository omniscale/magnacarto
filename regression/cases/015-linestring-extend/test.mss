Map { background-color: white; }

#test::line{
    line-width: 1;
}

#test::label{
    text-name: [name];
    text-size: 14;
    text-halo-radius: 2;
    text-halo-fill: #fff;
    text-extend: 50;

    text-placement-list: {
        text-size: 8;

    };

    text-face-name: "Noto Sans Regular";

    text-placement: line;
}
